{
	"name": "audinate-dantecontroller",
	"version": "2.0.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"probe:audio": "node tools/dante-rx-probe.mjs",
		"probe:video": "node tools/dante-video-probe.mjs",
		"test:watch": "vitest"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-audinate-dantecontroller.git"
	},
	"engines": {
		"node": "^26.7",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"es-toolkit": "^1.52.0",
		"multicast-dns": "^7.2.5"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/multicast-dns": "^7.2.4",
		"@types/node": "^26.4.1",
		"@vitest/coverage-v8": "5.0.0",
		"eslint": "^10.10.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.0"
}
